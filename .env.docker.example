# Docker Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# BACKEND CONFIGURATION
# ========================================

# Model Configuration
# zimage: prefer local Z-Image-Turbo; fall back to Small Stable Diffusion until ready
# auto: prefer ready local Z-Image-Turbo, then FLUX, then the small public model
# flux: force FLUX
# ollama: use an image-capable Ollama model over the configured Ollama host
# small: force the small public fallback model
# qwen: force Qwen-Image for text-rich posters, signs, and bilingual typography
# ernie: force ERNIE-Image-Turbo for prompt-enhanced multilingual text rendering
# turbo: force the fast turbo model
# smoke: force the internal smoke-test model
# mock: placeholder images only
IMAGE_BACKEND=zimage

# Backward compatibility for older scripts. Leave false when using IMAGE_BACKEND.
# Set to true only if you explicitly want placeholder images.
USE_MOCK_GENERATOR=false
MOCK_MODE=false

# Hugging Face Configuration
# Optional for the public fallback models. Required for gated/private model downloads.
# Get your token from: https://huggingface.co/settings/tokens
# Set this in your local environment, do not commit tokens to git
HF_TOKEN=

# Internal smoke-test model used only for diagnostics
SMOKE_TEST_MODEL=hf-internal-testing/tiny-stable-diffusion-torch

# Default first-run model for usable local images
SMALL_SD_MODEL=segmind/tiny-sd

# Optional fast few-step backend
TURBO_MODEL=stabilityai/sd-turbo

# Flux Model Selection
# Options: black-forest-labs/FLUX.1-schnell (Apache 2.0, commercial use allowed)
#          black-forest-labs/FLUX.1-dev (Non-commercial only)
FLUX_MODEL=black-forest-labs/FLUX.1-schnell

# Z-Image configuration
# Used by the Docker-local checkpoint copy and the new backend/LoRA controls in Settings.
ZIMAGE_MODEL_PATH=/app/ckpts/Z-Image-Turbo

# Qwen-Image configuration
QWEN_IMAGE_MODEL=diffusers/qwen-image-nf4
QWEN_IMAGE_PROMPT_MAGIC=true
QWEN_IMAGE_DEVICE_MAP=balanced
QWEN_IMAGE_LIGHTNING=false
QWEN_IMAGE_LIGHTNING_LORA=lightx2v/Qwen-Image-Lightning
QWEN_IMAGE_LIGHTNING_WEIGHT=Qwen-Image-Lightning-8steps-V1.0.safetensors

# ERNIE-Image configuration
# Released in April 2026; Turbo uses the 8-step Diffusers pipeline by default.
ERNIE_IMAGE_MODEL=baidu/ERNIE-Image-Turbo
ERNIE_IMAGE_PROMPT_ENHANCER=true

# Ollama Configuration
# If running Ollama locally, use host.docker.internal on Windows/Mac
# or the actual host IP on Linux
OLLAMA_HOST=http://host.docker.internal:11434
# Preferred local completion model. If this is stale, DreamGen will select an
# available completion-capable model and normalize the runtime setting.
OLLAMA_MODEL=llama3.2:3b
# Optional: only used when IMAGE_BACKEND=ollama
OLLAMA_IMAGE_MODEL=

# ========================================
# FRONTEND CONFIGURATION
# ========================================

# Node environment
NODE_ENV=production

# API endpoint for frontend
# For local-only Docker, localhost is fine. For Tailscale access from other devices,
# set this to your MagicDNS backend URL, for example:
# NEXT_PUBLIC_API_URL=http://mimir-wsl.tailfed532.ts.net:25800
NEXT_PUBLIC_API_URL=http://localhost:25800

# Optional public UI URL used by app metadata and ops links.
# NEXT_PUBLIC_SITE_URL=http://mimir-wsl.tailfed532.ts.net:7860
NEXT_PUBLIC_SITE_URL=http://localhost:7860

# Browser origins allowed to call the backend. Add your Tailscale UI origin here.
CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860,http://localhost:3000,http://127.0.0.1:3000

# ========================================
# DEVELOPMENT CONFIGURATION
# ========================================

# Logging
LOG_LEVEL=INFO

# Debug mode
DEBUG=false

# Hot reload (development only)
RELOAD=false

# Shared cache and model assets
AI_CACHE_DIR=./.cache

# Host gallery/output directory mounted into the backend.
# Leave as ./output for per-checkout output, or point at a durable gallery folder.
# On Windows, prefer forward slashes in .env.docker, for example:
# OUTPUT_HOST_DIR=C:/Users/vaski/projects/dreamgen/output
OUTPUT_HOST_DIR=./output

# ========================================
# GPU CONFIGURATION (Optional)
# ========================================

# CUDA settings (for NVIDIA GPUs)
# Uncomment and adjust if using GPU
# CUDA_VISIBLE_DEVICES=0
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# ========================================
# CSO MODULE CONFIGURATION
# ========================================

# These will be used when deploying as a CSO module
CSO_MODULE_NAME=continuous-image-gen
CSO_MODULE_VERSION=1.0.0
CSO_MODULE_TIER=custom

# GCP Configuration (for CSO deployment)
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
# GCS_BUCKET=your-image-bucket

# ========================================
# RESOURCE LIMITS
# ========================================

# Batch processing limits
MAX_BATCH_SIZE=20
DEFAULT_BATCH_SIZE=5
MAX_CONCURRENT=3

# Image generation settings
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
GUIDANCE_SCALE=0.0
NUM_INFERENCE_STEPS=4

# Port Configuration
BACKEND_PORT=25800
FRONTEND_PORT=7860

# ========================================
# OPTIONAL LORA / Z-IMAGE REVIEW DEFAULTS
# ========================================

# Local LoRAs are mounted from ./loras into /app/loras in the backend container.
LORA_DIR=/app/loras
ENABLED_LORAS=
LORA_APPLICATION_PROBABILITY=0.7

# Plugins can still be changed live in Settings, but these env vars set the boot defaults.
ENABLED_PLUGINS=time_of_day,art_style
PLUGIN_ORDER=time_of_day:1,art_style:2
