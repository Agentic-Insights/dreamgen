# DreamGen local configuration
# Copy to .env and adjust for your machine

# Image backend selection
# auto: use FLUX if cached, otherwise small public fallback
# flux: FLUX text-to-image
# ollama: Ollama image generation via the local Ollama host
# zimage: local Z-Image-Turbo checkout + weights
# small: small public Stable Diffusion fallback
# turbo: SD Turbo backend
# smoke: smoke-test model only
# mock: placeholder images only
IMAGE_BACKEND=auto

# Backward compatibility for older scripts
USE_MOCK_GENERATOR=false
MOCK_MODE=false

# Hugging Face token
# Optional for small/turbo/smoke public models.
# Required when downloading gated/private models such as some FLUX variants.
HF_TOKEN=

# Prompt generation
OLLAMA_MODEL=llama3.2:3b
# Optional: used only when IMAGE_BACKEND=ollama
OLLAMA_IMAGE_MODEL=
OLLAMA_TEMPERATURE=0.7
MAX_SEQUENCE_LENGTH=512

# FLUX configuration
FLUX_MODEL=black-forest-labs/FLUX.1-schnell

# Z-Image configuration
# Clone ref-repos/Z-Image and download weights locally before using IMAGE_BACKEND=zimage
ZIMAGE_MODEL_PATH=ckpts/Z-Image-Turbo
ZIMAGE_ATTENTION=_sdpa
ZIMAGE_COMPILE=false

# Fallback model configuration
SMOKE_TEST_MODEL=hf-internal-testing/tiny-stable-diffusion-torch
SMALL_SD_MODEL=segmind/tiny-sd
TURBO_MODEL=stabilityai/sd-turbo

# Image generation settings
IMAGE_HEIGHT=768
IMAGE_WIDTH=1360
NUM_INFERENCE_STEPS=4
GUIDANCE_SCALE=0.0
TRUE_CFG_SCALE=1.0

# Lora configuration
LORA_DIR=./loras
ENABLED_LORAS=
LORA_APPLICATION_PROBABILITY=0.7

# Plugin configuration
ENABLED_PLUGINS=time_of_day,nearest_holiday,holiday_fact,art_style,lora
PLUGIN_ORDER=time_of_day:1,nearest_holiday:2,holiday_fact:3,art_style:4,lora:5

# System configuration
OUTPUT_DIR=output
LOG_DIR=logs
CACHE_DIR=.cache
CPU_ONLY=false
MPS_USE_FP16=false
